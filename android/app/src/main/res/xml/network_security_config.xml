<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext erlaubt (Vertrag T6): frei konfigurierbare Provider-Basis-URL, z. B. lokaler http-Endpunkt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
